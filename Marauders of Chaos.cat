            <entryLink id="ed392222-3984-4dde-b6cb-1feb12b83e2f" name="Marauder Special Skills" hidden="false" collective="false" targetId="bda2107f-9277-4877-94d4-ea66c2cc04e5" type="selectionEntryGroup" sortIndex="9" import="true" />
          </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <rules>
        <rule id="934ce07c-ae01-401a-8497-f97fe7479395" name="Fear" hidden="false">
          <description>The Condemned causes fear.</description>
        </rule>
        <rule id="77d68a74-bed3-419a-bac3-fa84dc424012" name="Inconsistency" hidden="false">
          <description>Determine each variable characteristic once per turn, whenever needed.</description>
        </rule>
        <rule id="513864f9-ccb7-4d20-94fd-5c9252b36cff" name="Experience" hidden="false">
          <description>When a variable characteristic would increase, roll its die and either fix it at that result or leave it variable and lose the advance. These values may exceed normal Marauder maximums.</description>
        </rule>
        <rule id="7abe118c-d895-46e1-828c-ee555ad86ea3" name="Fate" hidden="false">
          <description>The Condemned uses no equipment until every variable characteristic is fixed. Once fixed he may use equipment normally. At 90 Experience, any still-variable Condemned becomes a Spawn; if one already exists, he leaves the warband.</description>
        </rule>
        <rule id="551fcfb2-c4c6-4790-a4d2-86c9d6ada796" name="Equipment restriction" hidden="false">
          <description>The Condemned starts unable to use weapons, armour or miscellaneous equipment; select equipment only after all variable attributes have been fixed.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="0ea7d1b7-ca7b-4d96-9d6c-2111a71c1db4" name="Marauder of Chaos max" hidden="false" targetId="4b929c86-0544-4c4a-87b1-01ad63270f83" type="profile" />
      </infoLinks>
    </selectionEntry>
