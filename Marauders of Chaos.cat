    <selectionEntryGroup id="moc-special-skills" name="Marauder Special Skills" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry id="moc-skill-chosen" name="Chosen of Chaos" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-skill-chosen-max"/></constraints><rules><rule id="moc-skill-chosen-rule" name="Chosen of Chaos" hidden="false"><description>The Hero enters the rank of Chaos Warrior, uses the Warriors of Chaos maximum profile, and may use the Hero Equipment List.</description></rule></rules></selectionEntry>
        <selectionEntry id="moc-skill-tattoo" name="Tattooed Body" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-skill-tattoo-max"/></constraints><rules><rule id="moc-skill-tattoo-rule" name="Tattooed Body" hidden="false"><description>Leader only. Eye of the Gods awards a Mark or creates a Spawn on 10+ instead of 12+ (11+ for a Norse leader).</description></rule></rules></selectionEntry>
        <selectionEntry id="moc-skill-sweeping" name="Sweeping Blow" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-skill-sweeping-max"/></constraints><rules><rule id="moc-skill-sweeping-rule" name="Sweeping Blow" hidden="false"><description>Requires Strongman. When the Hero takes an enemy out of action with a double-handed weapon, immediately make another attack against a different model in base contact.</description></rule></rules></selectionEntry>
        <selectionEntry id="moc-skill-mutant" name="Mutant" hidden="false" collective="true" import="true" type="upgrade"><rules><rule id="moc-skill-mutant-rule" name="Mutant" hidden="false"><description>The Hero may buy one mutation. A Hero with the Mark of Onogal may instead choose a Blessing of Nurgle other than Mark of Nurgle. This skill may be taken more than once.</description></rule></rules><entryLinks><entryLink id="moc-skill-mutations" name="Mutations" hidden="false" collective="false" import="true" targetId="5541-f5c4-85e0-b399" type="selectionEntryGroup"/></entryLinks></selectionEntry>
        <selectionEntry id="moc-skill-heart" name="Heart of the Warrior" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-skill-heart-max"/></constraints><rules><rule id="moc-skill-heart-rule" name="Heart of the Warrior" hidden="false"><description>Leader only. The Hero may re-roll failed Rout tests and is immune to fear and all alone tests.</description></rule></rules></selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>

    <selectionEntryGroup id="moc-tchar-rituals" name="Tchar Rituals" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry id="moc-tchar-1" name="1 Tchar&apos;s Blessing" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-tchar-1-max"/></constraints><profiles><profile id="moc-tchar-1-profile" name="Tchar&apos;s Blessing" hidden="false" typeId="d891-ee2b-b7dc-f545" typeName="Magic"><characteristics><characteristic name="Difficulty" typeId="dd91-3f4d-8b72-7905">Automatic</characteristic><characteristic name="Effect" typeId="0592-3510-8508-7263">This spell must be used before the game and may be used only once. If the Seer casts no spells in the following battle and is not taken out of action, he gains +D3 Experience.</characteristic></characteristics></profile></profiles></selectionEntry>
        <selectionEntry id="moc-tchar-2" name="2 Irridecence" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-tchar-2-max"/></constraints><profiles><profile id="moc-tchar-2-profile" name="Irridecence" hidden="false" typeId="d891-ee2b-b7dc-f545" typeName="Magic"><characteristics><characteristic name="Difficulty" typeId="dd91-3f4d-8b72-7905">7</characteristic><characteristic name="Effect" typeId="0592-3510-8508-7263">Like a violent rainbow, a blast of ever-changing colour crashes over the target. Irridecence inflicts D6 hits at D6 Strength upon the target.</characteristic></characteristics></profile></profiles></selectionEntry>
        <selectionEntry id="moc-tchar-3" name="3 Dimensional Collapse" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-tchar-3-max"/></constraints><profiles><profile id="moc-tchar-3-profile" name="Dimensional Collapse" hidden="false" typeId="d891-ee2b-b7dc-f545" typeName="Magic"><characteristics><characteristic name="Difficulty" typeId="dd91-3f4d-8b72-7905">13</characteristic><characteristic name="Effect" typeId="0592-3510-8508-7263">All enemy models within 12&quot; suffer a Strength 10 hit. The caster is immediately killed and must be removed from the roster. This spell may only be cast once the caster has 30 or more Experience.</characteristic></characteristics></profile></profiles></selectionEntry>
        <selectionEntry id="moc-tchar-4" name="4 Wrath of the Eagle" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-tchar-4-max"/></constraints><profiles><profile id="moc-tchar-4-profile" name="Wrath of the Eagle" hidden="false" typeId="d891-ee2b-b7dc-f545" typeName="Magic"><characteristics><characteristic name="Difficulty" typeId="dd91-3f4d-8b72-7905">9</characteristic><characteristic name="Effect" typeId="0592-3510-8508-7263">Choose one enemy warrior within 12&quot;. The target takes one hit at a Strength equal to the difference between the target&apos;s and caster&apos;s Experience points, whether positive or negative, to a maximum of Strength 10.</characteristic></characteristics></profile></profiles></selectionEntry>
        <selectionEntry id="moc-tchar-5" name="5 Tchar&apos;s Reward" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-tchar-5-max"/></constraints><profiles><profile id="moc-tchar-5-profile" name="Tchar&apos;s Reward" hidden="false" typeId="d891-ee2b-b7dc-f545" typeName="Magic"><characteristics><characteristic name="Difficulty" typeId="dd91-3f4d-8b72-7905">8</characteristic><characteristic name="Effect" typeId="0592-3510-8508-7263">The Seer gains +1 to one characteristic of his choice for every 10 Experience points he has. The effect lasts until the start of his next Shooting phase.</characteristic></characteristics></profile></profiles></selectionEntry>
        <selectionEntry id="moc-tchar-6" name="6 Elevated Mind" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-tchar-6-max"/></constraints><profiles><profile id="moc-tchar-6-profile" name="Elevated Mind" hidden="false" typeId="d891-ee2b-b7dc-f545" typeName="Magic"><characteristics><characteristic name="Difficulty" typeId="dd91-3f4d-8b72-7905">6</characteristic><characteristic name="Effect" typeId="0592-3510-8508-7263">Choose one enemy spellcaster within 18&quot;. Whenever that model casts a spell, the Seer gains 1 Experience point. The effect lasts until the start of the Seer&apos;s next Shooting phase.</characteristic></characteristics></profile></profiles></selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>

    <selectionEntryGroup id="moc-onogal-rituals" name="Onogal Rituals" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry id="moc-onogal-1" name="1 Touch of Onogal" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-onogal-1-max"/></constraints><profiles><profile id="moc-onogal-1-profile" name="Touch of Onogal" hidden="false" typeId="d891-ee2b-b7dc-f545" typeName="Magic"><characteristics><characteristic name="Difficulty" typeId="dd91-3f4d-8b72-7905">10</characteristic><characteristic name="Effect" typeId="0592-3510-8508-7263">Use against one of the Seer&apos;s close combat opponents. If he takes the model out of action in the following hand-to-hand combat phase, roll for Serious Injuries immediately. If the model dies permanently, replace it with a Nurgle Plaguebearer under the Seer&apos;s control for the rest of the game. If the Seer is stunned or taken out of action, the Plaguebearer disappears. Only one Plaguebearer may be created at a time.</characteristic></characteristics></profile></profiles></selectionEntry>
        <selectionEntry id="moc-onogal-2" name="2 Buboes" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-onogal-2-max"/></constraints><profiles><profile id="moc-onogal-2-profile" name="Buboes" hidden="false" typeId="d891-ee2b-b7dc-f545" typeName="Magic"><characteristics><characteristic name="Difficulty" typeId="dd91-3f4d-8b72-7905">7</characteristic><characteristic name="Effect" typeId="0592-3510-8508-7263">Range 8&quot;. One enemy warrior must pass a Toughness test or lose one Wound. No armour saves are allowed.</characteristic></characteristics></profile></profiles></selectionEntry>
        <selectionEntry id="moc-onogal-3" name="3 Stench of Nurgle" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-onogal-3-max"/></constraints><profiles><profile id="moc-onogal-3-profile" name="Stench of Nurgle" hidden="false" typeId="d891-ee2b-b7dc-f545" typeName="Magic"><characteristics><characteristic name="Difficulty" typeId="dd91-3f4d-8b72-7905">8</characteristic><characteristic name="Effect" typeId="0592-3510-8508-7263">Range 6&quot;; affects all living creatures, friend or foe. Each enemy warrior in range must pass a Toughness test or lose one Attack until their next turn.</characteristic></characteristics></profile></profiles></selectionEntry>
        <selectionEntry id="moc-onogal-4" name="4 Pestilence" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-onogal-4-max"/></constraints><profiles><profile id="moc-onogal-4-profile" name="Pestilence" hidden="false" typeId="d891-ee2b-b7dc-f545" typeName="Magic"><characteristics><characteristic name="Difficulty" typeId="dd91-3f4d-8b72-7905">10</characteristic><characteristic name="Effect" typeId="0592-3510-8508-7263">All enemy models within 12&quot; of the Seer suffer a Strength 3 hit. No armour saves are allowed.</characteristic></characteristics></profile></profiles></selectionEntry>
        <selectionEntry id="moc-onogal-5" name="5 Scabrous Hide" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-onogal-5-max"/></constraints><profiles><profile id="moc-onogal-5-profile" name="Scabrous Hide" hidden="false" typeId="d891-ee2b-b7dc-f545" typeName="Magic"><characteristics><characteristic name="Difficulty" typeId="dd91-3f4d-8b72-7905">8</characteristic><characteristic name="Effect" typeId="0592-3510-8508-7263">The Seer has a 2+ armour save, replacing any normal armour save, until the beginning of his next Shooting phase.</characteristic></characteristics></profile></profiles></selectionEntry>
        <selectionEntry id="moc-onogal-6" name="6 Nurgle&apos;s Rot" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-onogal-6-max"/></constraints><profiles><profile id="moc-onogal-6-profile" name="Nurgle&apos;s Rot" hidden="false" typeId="d891-ee2b-b7dc-f545" typeName="Magic"><characteristics><characteristic name="Difficulty" typeId="dd91-3f4d-8b72-7905">9</characteristic><characteristic name="Effect" typeId="0592-3510-8508-7263">All enemy models in base contact with the Seer must immediately test against Toughness or contract Nurgle&apos;s Rot.</characteristic></characteristics></profile></profiles></selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>

    <selectionEntryGroup id="moc-shornaal-rituals" name="Shornaal Rituals" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry id="moc-shornaal-1" name="1 Delicious Suffering" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-shornaal-1-max"/></constraints><profiles><profile id="moc-shornaal-1-profile" name="Delicious Suffering" hidden="false" typeId="d891-ee2b-b7dc-f545" typeName="Magic"><characteristics><characteristic name="Difficulty" typeId="dd91-3f4d-8b72-7905">8</characteristic><characteristic name="Effect" typeId="0592-3510-8508-7263">All models, friend and foe except the Seer, within 3&quot; must pass a Leadership test or be knocked down. This has no effect on models immune to psychology.</characteristic></characteristics></profile></profiles></selectionEntry>
        <selectionEntry id="moc-shornaal-2" name="2 Dance of the Serpent" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-shornaal-2-max"/></constraints><profiles><profile id="moc-shornaal-2-profile" name="Dance of the Serpent" hidden="false" typeId="d891-ee2b-b7dc-f545" typeName="Magic"><characteristics><characteristic name="Difficulty" typeId="dd91-3f4d-8b72-7905">8</characteristic><characteristic name="Effect" typeId="0592-3510-8508-7263">Enemy models not immune to psychology suffer -1 to hit the Seer and any ally within 4&quot; of him. The effect lasts until the start of the Seer&apos;s next Shooting phase.</characteristic></characteristics></profile></profiles></selectionEntry>
        <selectionEntry id="moc-shornaal-3" name="3 Endless Torment" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-shornaal-3-max"/></constraints><profiles><profile id="moc-shornaal-3-profile" name="Endless Torment" hidden="false" typeId="d891-ee2b-b7dc-f545" typeName="Magic"><characteristics><characteristic name="Difficulty" typeId="dd91-3f4d-8b72-7905">8</characteristic><characteristic name="Effect" typeId="0592-3510-8508-7263">Choose one enemy model within 12&quot;. After each of its Recovery phases, the target rolls on the Injury table with a -1 modifier. For the duration of the Torment the Seer can do nothing except end the spell at the beginning of his turn. If attacked in close combat, the Seer is hit automatically and the spell ends.</characteristic></characteristics></profile></profiles></selectionEntry>
        <selectionEntry id="moc-shornaal-4" name="4 Mystify" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-shornaal-4-max"/></constraints><profiles><profile id="moc-shornaal-4-profile" name="Mystify" hidden="false" typeId="d891-ee2b-b7dc-f545" typeName="Magic"><characteristics><characteristic name="Difficulty" typeId="dd91-3f4d-8b72-7905">7</characteristic><characteristic name="Effect" typeId="0592-3510-8508-7263">One enemy model within 8&quot; has Initiative 1 and always strikes last, even if it charged or is using a spear or pike when charged. The spell lasts until the target passes a Leadership test during its Recovery phase.</characteristic></characteristics></profile></profiles></selectionEntry>
        <selectionEntry id="moc-shornaal-5" name="5 A Thousand Voices" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-shornaal-5-max"/></constraints><profiles><profile id="moc-shornaal-5-profile" name="A Thousand Voices" hidden="false" typeId="d891-ee2b-b7dc-f545" typeName="Magic"><characteristics><characteristic name="Difficulty" typeId="dd91-3f4d-8b72-7905">8</characteristic><characteristic name="Effect" typeId="0592-3510-8508-7263">Choose one enemy model within 12&quot;. Its Leadership is reduced by D3+1, to a minimum of 2. Models immune to psychology are unaffected. The target must pass a Leadership test at the beginning of its turn to end the spell; the spell also ends if the Seer loses a Wound. Only one model may be affected at a time.</characteristic></characteristics></profile></profiles></selectionEntry>
        <selectionEntry id="moc-shornaal-6" name="6 Shornaal&apos;s Temptation" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-shornaal-6-max"/></constraints><profiles><profile id="moc-shornaal-6-profile" name="Shornaal&apos;s Temptation" hidden="false" typeId="d891-ee2b-b7dc-f545" typeName="Magic"><characteristics><characteristic name="Difficulty" typeId="dd91-3f4d-8b72-7905">7</characteristic><characteristic name="Effect" typeId="0592-3510-8508-7263">Choose one enemy model within 8&quot; that is not immune to psychology. If it fails a Leadership test, the Seer controls it. Its player may test Leadership in each Recovery phase to regain control. Only one model may be controlled at a time. Whenever the Seer is hit, he must pass a Leadership test or the spell ends.</characteristic></characteristics></profile></profiles></selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>

    <selectionEntryGroup id="moc-marks" name="Marks of the Dark Gods" hidden="false" collective="false" import="true">
      <constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-marks-max"/></constraints>
      <rules><rule id="moc-mark-limit" name="Marks of the Dark Gods" hidden="false"><description>Except for Chaos Undivided, the warband may never include models with different Marks. Seers choose a Mark when hired. A leader receives one only through Eye of the Gods.</description></rule></rules>
      <selectionEntries>
        <selectionEntry id="moc-mark-undivided" name="Mark of Chaos Undivided" hidden="false" collective="false" import="true" type="upgrade">
          <constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-mark-undivided-max"/></constraints>
          <rules><rule id="moc-mark-undivided-rule" name="Mark of Chaos Undivided" hidden="false"><description>Leader: warband members within the Leader radius may re-roll failed Leadership tests. Seer: the warband may include 0-3 Gors, which count toward its model maximum; re-roll The Lad&apos;s Got Talent results for them. A Seer uses Chaos Rituals.</description></rule></rules>
          <selectionEntries><selectionEntry id="moc-undivided-gor-access" name="Gors (0-3 enabled)" hidden="true" collective="false" import="true" type="upgrade"><modifiers><modifier type="set" field="hidden" value="false"><conditions><condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="moc-seer" shared="true"/></conditions></modifier></modifiers><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="moc-undivided-gor-access-min"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-undivided-gor-access-max"/></constraints></selectionEntry></selectionEntries>
          <entryLinks><entryLink id="moc-mark-chaos-rituals" name="Chaos Rituals (one random starting ritual)" hidden="true" collective="false" import="true" targetId="61c7-8179-00b5-1772" type="selectionEntryGroup"><modifiers><modifier type="set" field="hidden" value="false"><conditions><condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="moc-seer" shared="true"/></conditions></modifier></modifiers><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="moc-chaos-ritual-min"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-chaos-ritual-max"/></constraints></entryLink></entryLinks>
        </selectionEntry>
        <selectionEntry id="moc-mark-tchar" name="Mark of Tchar the Eagle" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers><modifier type="add" field="error" value="A warband may not combine different non-Undivided Marks."><conditionGroups><conditionGroup type="or"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="moc-mark-arkhar" shared="true" includeChildSelections="true"/><condition type="atLeast" value="1" field="selections" scope="roster" childId="moc-mark-onogal" shared="true" includeChildSelections="true"/><condition type="atLeast" value="1" field="selections" scope="roster" childId="moc-mark-shornaal" shared="true" includeChildSelections="true"/></conditions></conditionGroup></conditionGroups></modifier></modifiers>
          <constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-mark-tchar-max"/></constraints>
          <rules><rule id="moc-mark-tchar-rule" name="Mark of Tchar the Eagle" hidden="false"><description>Leader: becomes a spellcaster, learns one random Tchar Ritual, and suffers -1 on Difficulty rolls unless already a wizard. Seer: starts with two Tchar Rituals, one chosen and one random.</description></rule></rules>
          <entryLinks><entryLink id="moc-mark-tchar-rituals" name="Tchar Rituals (Seer: choose one and determine one randomly)" hidden="false" collective="false" import="true" targetId="moc-tchar-rituals" type="selectionEntryGroup"><modifiers><modifier type="set" field="moc-tchar-ritual-min" value="2"><conditions><condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="moc-seer" shared="true"/></conditions></modifier><modifier type="set" field="moc-tchar-ritual-max" value="2"><conditions><condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="moc-seer" shared="true"/></conditions></modifier></modifiers><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="moc-tchar-ritual-min"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-tchar-ritual-max"/></constraints></entryLink></entryLinks>
        </selectionEntry>
        <selectionEntry id="moc-mark-arkhar" name="Mark of Arkhar the Dog" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers><modifier type="add" field="error" value="A warband may not combine different non-Undivided Marks."><conditionGroups><conditionGroup type="or"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="moc-mark-tchar" shared="true" includeChildSelections="true"/><condition type="atLeast" value="1" field="selections" scope="roster" childId="moc-mark-onogal" shared="true" includeChildSelections="true"/><condition type="atLeast" value="1" field="selections" scope="roster" childId="moc-mark-shornaal" shared="true" includeChildSelections="true"/></conditions></conditionGroup></conditionGroups></modifier></modifiers>
          <constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-mark-arkhar-max"/></constraints><rules><rule id="moc-mark-arkhar-rule" name="Mark of Arkhar the Dog" hidden="false"><description>Leader: is subject to frenzy; spells targeting him fail on 4+. Seer: becomes a Bloodfather, cannot cast spells, and may take Strength skills. Each time he takes an enemy out in hand-to-hand combat, pass a Leadership test to add +1 to WS, S, T or I until battle end; each may increase once.</description></rule></rules>
        </selectionEntry>
        <selectionEntry id="moc-mark-onogal" name="Mark of Onogal the Crow" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers><modifier type="add" field="error" value="A warband may not combine different non-Undivided Marks."><conditionGroups><conditionGroup type="or"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="moc-mark-tchar" shared="true" includeChildSelections="true"/><condition type="atLeast" value="1" field="selections" scope="roster" childId="moc-mark-arkhar" shared="true" includeChildSelections="true"/><condition type="atLeast" value="1" field="selections" scope="roster" childId="moc-mark-shornaal" shared="true" includeChildSelections="true"/></conditions></conditionGroup></conditionGroups></modifier></modifiers>
          <constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-mark-onogal-max"/></constraints><rules><rule id="moc-mark-onogal-rule" name="Mark of Onogal the Crow" hidden="false"><description>Leader: +1 Toughness, immune to poison, and may re-roll once on the Serious Injuries table. Seer: uses Onogal Rituals and is immune to poison.</description></rule></rules>
          <entryLinks><entryLink id="moc-mark-onogal-rituals" name="Onogal Rituals (one random starting ritual)" hidden="true" collective="false" import="true" targetId="moc-onogal-rituals" type="selectionEntryGroup"><modifiers><modifier type="set" field="hidden" value="false"><conditions><condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="moc-seer" shared="true"/></conditions></modifier></modifiers><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="moc-onogal-ritual-min"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-onogal-ritual-max"/></constraints></entryLink></entryLinks>
        </selectionEntry>
        <selectionEntry id="moc-mark-shornaal" name="Mark of Shornaal the Serpent" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers><modifier type="add" field="error" value="A warband may not combine different non-Undivided Marks."><conditionGroups><conditionGroup type="or"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="moc-mark-tchar" shared="true" includeChildSelections="true"/><condition type="atLeast" value="1" field="selections" scope="roster" childId="moc-mark-arkhar" shared="true" includeChildSelections="true"/><condition type="atLeast" value="1" field="selections" scope="roster" childId="moc-mark-onogal" shared="true" includeChildSelections="true"/></conditions></conditionGroup></conditionGroups></modifier></modifiers>
          <constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-mark-shornaal-max"/></constraints><rules><rule id="moc-mark-shornaal-rule" name="Mark of Shornaal the Serpent" hidden="false"><description>Leader: enemies not immune to psychology must pass a Leadership test on 3D6, discarding the lowest, before attacking him in close combat; on failure they are hit automatically, and once passed they need not retest that battle. Seer: uses Shornaal Rituals and, if not taken out, may brew unsellable Bugman&apos;s Ale instead of searching for a rare item.</description></rule></rules>
          <entryLinks><entryLink id="moc-mark-shornaal-rituals" name="Shornaal Rituals (one random starting ritual)" hidden="true" collective="false" import="true" targetId="moc-shornaal-rituals" type="selectionEntryGroup"><modifiers><modifier type="set" field="hidden" value="false"><conditions><condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="moc-seer" shared="true"/></conditions></modifier></modifiers><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="moc-shornaal-ritual-min"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-shornaal-ritual-max"/></constraints></entryLink></entryLinks>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
  <catalogueLinks><catalogueLink type="catalogue" name="data" id="moc-data-link" targetId="e020-c282-277b-b173" importRootEntries="true"/></catalogueLinks>
