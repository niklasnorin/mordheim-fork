              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry id="54d2eaae-bef0-4269-a4d9-2655cbb91157" name="Mark of Arkhar the Dog" hidden="false" collective="false" type="upgrade" import="true">
          <rules>
            <rule id="6da597d5-6197-4190-bce9-1a6a498ad92b" name="Mark of Arkhar the Dog" hidden="false">
              <description>Leader: gains frenzy; spells targeting him fail on 4+. Seer: becomes a Bloodfather, cannot cast spells, and may take Strength skills. Each time he takes an enemy out of action in hand-to-hand combat, pass a Leadership test to gain +1 WS, S, T or I until battle end; each may increase once.</description>
            </rule>
          </rules>
          <costs>
            <cost name=" gc" typeId="points" value="0" />
            <cost name=" Warband Rating" typeId="wb-rating" value="0" />
          </costs>
          <modifiers>
            <modifier type="add" field="error" value="The warband may not include different Marks of Chaos (Chaos Undivided is the exception).">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="1369e859-5870-4423-9be2-87d8775af9fe" shared="true" />
              </conditions>
            </modifier>
            <modifier type="add" field="error" value="The warband may not include different Marks of Chaos (Chaos Undivided is the exception).">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="ed91ea4c-8661-4240-b79c-cd2d482ee758" shared="true" />
              </conditions>
            </modifier>
            <modifier type="add" field="error" value="The warband may not include different Marks of Chaos (Chaos Undivided is the exception).">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="264e500e-e009-4c24-9a84-b2fa6d8a6552" shared="true" />
              </conditions>
