          </modifiers>
        </selectionEntry>
        <selectionEntry id="ed91ea4c-8661-4240-b79c-cd2d482ee758" name="Mark of Onogal the Crow" hidden="false" collective="false" type="upgrade" import="true">
          <rules>
            <rule id="75ea7c3c-996d-4d94-81a9-86e3cd1dd6c4" name="Mark of Onogal the Crow" hidden="false">
              <description>Leader: +1 Toughness, one Serious Injury re-roll, and immunity to poison. Seer: uses Onogal Rituals and is immune to poison.</description>
            </rule>
          </rules>
          <costs>
            <cost name=" gc" typeId="points" value="0" />
            <cost name=" Warband Rating" typeId="wb-rating" value="0" />
          </costs>
          <entryLinks>
            <entryLink id="1789c16c-cfe5-478e-9c36-4827ce8f8192" name="Onogal Rituals" hidden="false" collective="false" targetId="628af566-34b6-4d45-a416-5af0ce34644d" type="selectionEntryGroup" sortIndex="1" import="true" />
