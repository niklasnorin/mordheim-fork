      <rules>
        <rule id="25d6b113-178e-459a-8175-b985ac0b623f" name="Leader" hidden="false">
          <description>Any warrior within 6” may use the Marauder Chieftain’s Leadership when taking Leadership tests.</description>
        </rule>
        <rule id="2bf910d8-dc12-4299-a1f1-e22273fcfb20" name="Eye of the Gods" hidden="false">
          <description>Roll 2D6 after every battle. After a loss add +1 per Hero taken out of action; on 12+ the leader becomes a Spawn, losing experience, skills, injuries and equipment. After a win add +1 per enemy the leader took out of action; on 12+ choose a Mark of Chaos. Stop testing after gaining a Mark. Do not test if the leader missed the battle.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="d600d39d-91bb-4d66-a407-6f4efdbc02b4" name="Marauder of Chaos max" hidden="false" targetId="4b929c86-0544-4c4a-87b1-01ad63270f83" type="profile" />
      </infoLinks>
    </selectionEntry>
