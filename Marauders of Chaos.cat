      <rules><rule id="moc-wizard" name="Wizard" hidden="false"><description>A Seer is a Wizard. His required Mark determines whether he uses Chaos, Tchar, Onogal or Shornaal Rituals, or becomes an Arkhar Bloodfather.</description></rule></rules>
      <categoryLinks><categoryLink id="moc-seer-cat" name="Heroes" hidden="false" targetId="a0fce0bc-02e0-a064-7a39-5b97ff8a9c94" primary="true"/><categoryLink id="moc-seer-member" name="Warband Members" hidden="false" targetId="moc-warband-members" primary="false"/></categoryLinks>
