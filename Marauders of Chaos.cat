    <selectionEntry id="a3fda0bb-9782-4da5-9f1b-b150b1aee829" name="Warband Rules" hidden="false" collective="false" type="upgrade" import="true">
      <categoryLinks>
        <categoryLink id="91a64c76-dd11-46d5-8e53-6338c29a91c7" name="Configuration" hidden="false" targetId="4852-c4cb-82b0-b7fa" primary="true" />
      </categoryLinks>
      <constraints>
        <constraint field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="29240043-e384-4aa3-a4c8-58768668c3c6" type="min" />
        <constraint field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="16d6ccb5-4cab-4b92-8826-28dcb35dacaf" type="max" />
      </constraints>
      <rules>
        <rule id="4893e72d-1fcf-4d3a-81b3-d2f7543a6ec5" name="Roster" hidden="false">
          <description>A Marauders of Chaos warband starts with 500 gc, must include at least 3 warriors, and may include at most 15 warriors (12 for Hung). It may never include more than one Spawn of Chaos.</description>
        </rule>
        <rule id="10d8c0da-9458-4557-a609-1bd9952cb6df" name="Hired Swords" hidden="false">
          <description>May hire Pit Fighters, Ogres, Norse Shamans, Imperial Assassins, and Hired Swords that explicitly permit Marauders. Witches and Warlocks may be hired unless the warband includes the Mark of Arkhar.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="808dd61f-5738-41cb-82b3-65f64fc032ee" name="Follow the Darkest Tribe" hidden="false" collapsible="false">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="065c38db-30ad-4d03-92f2-5e75334ee625" type="min" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="26c1f2ff-082f-4854-b795-0153c9d27db5" type="max" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="8e98dfad-bbb4-4b5b-9fe7-23c66db6aad2" name="The Norse" hidden="false" collective="false" type="upgrade" import="true">
              <rules>
                <rule id="ff44f8ab-5562-446e-b310-81a55514849e" name="The Norse" hidden="false">
                  <description>Reavers: +1 to rarity rolls in the post-game sequence. Pantheon: Eye of the Gods effects occur on 13+ instead of 12+. Tattooed Body reduces this to 11+.</description>
                </rule>
              </rules>
              <costs>
                <cost name=" gc" typeId="points" value="0" />
                <cost name=" Warband Rating" typeId="wb-rating" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry id="d8ea6036-aedd-41ea-a19b-da4459b4c11f" name="The Kurgan" hidden="false" collective="false" type="upgrade" import="true">
              <rules>
                <rule id="eee966ca-39b3-4e45-9601-2dc694046a74" name="The Kurgan" hidden="false">
                  <description>Pedigree: the warband may include any number of Warhounds of Chaos, rather than 0–5.</description>
                </rule>
              </rules>
              <costs>
                <cost name=" gc" typeId="points" value="0" />
                <cost name=" Warband Rating" typeId="wb-rating" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry id="bed98f8d-ecc6-4be3-b9f3-6555f8deac61" name="The Hung" hidden="false" collective="false" type="upgrade" import="true">
              <rules>
                <rule id="d4b7c292-6a2e-421e-ae8e-5a3b994a4410" name="The Hung" hidden="false">
                  <description>Disloyalty: maximum warband size is 12. Affinity with Horses: Warhorses always cost 40 gc and every Hero, including promoted Henchmen, automatically has Ride Warhorse. Mounts are unrestricted in Border Town Burning.</description>
                </rule>
              </rules>
              <costs>
                <cost name=" gc" typeId="points" value="0" />
                <cost name=" Warband Rating" typeId="wb-rating" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <modifiers>
        <modifier type="add" field="error" value="A Marauders warband may not contain more than 15 warriors.">
          <conditions>
            <condition type="atLeast" value="16" field="selections" scope="roster" childId="model" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
        <modifier type="add" field="error" value="A Hung warband may not contain more than 12 warriors.">
          <conditions>
            <condition type="atLeast" value="13" field="selections" scope="roster" childId="model" shared="true" includeChildSelections="true" includeChildForces="false" />
            <condition type="atLeast" value="1" field="selections" scope="roster" childId="bed98f8d-ecc6-4be3-b9f3-6555f8deac61" shared="true" />
          </conditions>
        </modifier>
        <modifier type="add" field="error" value="A Marauders warband must contain at least 3 warriors.">
          <conditions>
            <condition type="atMost" value="2" field="selections" scope="roster" childId="model" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="551507d3-86d2-4153-b17f-4c37df403018" name="Grade 1c" hidden="false" collective="false" type="upgrade" import="true">
      <constraints>
        <constraint field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6690dfb3-b7ea-4234-86fe-41b2d0ce62a1" type="min" />
        <constraint field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c709c281-a593-4bce-8cbb-7acf282288b6" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="efe9fb0b-4307-44cf-8b96-36a634cea427" name="Configuration" targetId="4852-c4cb-82b0-b7fa" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="d8c56649-2ef6-4fee-901f-1de94a064fd7" name="Grade 1c" hidden="false">
          <description>Experimental material published in Border Town Burning and listed as Grade 1c.</description>
        </rule>
      </rules>
    </selectionEntry>
  </selectionEntries>
  <rules>
    <rule id="9589b916-b9f5-4e57-b174-cd1de1fb1107" name="Marks of the Dark Gods" hidden="false">
      <description>Except for Chaos Undivided, the warband may never contain warriors with different Marks. Seers choose a Mark when hired. A leader gaining a Mark through Eye of the Gods must choose the patron corresponding to the Seer.</description>
    </rule>
  </rules>
  <sharedSelectionEntryGroups>
    <selectionEntryGroup id="bda2107f-9277-4877-94d4-ea66c2cc04e5" name="Marauder Special Skills" hidden="false" collective="false" collapsible="true" import="true">
      <selectionEntries>
        <selectionEntry id="0d5cd10e-1d14-4f21-a976-9a28ae78c9dd" name="Chosen of Chaos" hidden="false" collective="false" type="upgrade" import="true">
          <rules>
            <rule id="bb7fb534-21b0-43fa-809b-3f64de88d336" name="Chosen of Chaos" hidden="false">
              <description>The Hero uses the Warriors of Chaos maximum profile and Hero Equipment list.</description>
            </rule>
          </rules>
          <costs>
            <cost name=" gc" typeId="points" value="0" />
            <cost name=" Warband Rating" typeId="wb-rating" value="0" />
          </costs>
          <infoLinks>
            <infoLink id="0dbff62b-b147-4c27-b925-7ef7a926f43e" name="Warrior of Chaos max" hidden="false" targetId="bb2b1a52-3142-4447-9144-565cb1a83979" type="profile" />
          </infoLinks>
        </selectionEntry>
        <selectionEntry id="09126764-ffe4-4686-bcc4-5197d2b0c42b" name="Tattooed Body" hidden="false" collective="false" type="upgrade" import="true">
          <rules>
            <rule id="1546bf1c-35fe-4175-87e5-dadab71ca10e" name="Tattooed Body" hidden="false">
              <description>Leader only. Eye of the Gods effects occur on 10+ instead of 12+; for Norse leaders they occur on 11+.</description>
            </rule>
          </rules>
          <costs>
            <cost name=" gc" typeId="points" value="0" />
            <cost name=" Warband Rating" typeId="wb-rating" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="692dc898-bce1-4e1e-a7ac-ddaa34278abf" name="Sweeping Blow" hidden="false" collective="false" type="upgrade" import="true">
          <rules>
            <rule id="67d7d10f-4c76-4bfa-a3bf-f83adf732215" name="Sweeping Blow" hidden="false">
              <description>After taking an enemy out of action with a double-handed weapon, immediately attack another model in base contact. Requires Strongman.</description>
            </rule>
          </rules>
          <costs>
            <cost name=" gc" typeId="points" value="0" />
            <cost name=" Warband Rating" typeId="wb-rating" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="1756a37e-7fb0-4f83-8760-7f9f39f03a61" name="Mutant" hidden="false" collective="false" type="upgrade" import="true">
          <rules>
            <rule id="47808539-ee6e-4657-bf91-be2182f576ae" name="Mutant" hidden="false">
              <description>Buy one mutation. Heroes with the Mark of Onogal may instead choose a Blessing of Nurgle other than Mark of Nurgle. This skill may be taken more than once.</description>
            </rule>
          </rules>
          <costs>
            <cost name=" gc" typeId="points" value="0" />
            <cost name=" Warband Rating" typeId="wb-rating" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="582627bf-f902-4d9a-83f1-6065bb262091" name="Heart of the Warrior" hidden="false" collective="false" type="upgrade" import="true">
          <rules>
            <rule id="d4b186d3-ae96-4850-bc70-012bfcea8c91" name="Heart of the Warrior" hidden="false">
              <description>Leader only. Re-roll failed Rout tests and become immune to fear and all alone tests.</description>
            </rule>
          </rules>
          <costs>
            <cost name=" gc" typeId="points" value="0" />
            <cost name=" Warband Rating" typeId="wb-rating" value="0" />
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
