<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue id="6f31-2d7a-a9c4-1e85" name="Marauders of Chaos (1c)" revision="1" battleScribeVersion="2.03" library="false" gameSystemId="9481a749-7900-614b-1695-bdc2899069c1" gameSystemRevision="16" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <publications>
    <publication id="moc-pub-1c" name="Marauders of Chaos" shortName="Marauders" publisher="The New Mordheimer" publisherUrl="https://mordheimer.net/docs/warbands/grade-1c-warbands/marauders-of-chaos"/>
  </publications>
  <categoryEntries>
    <categoryEntry id="moc-warband-members" name="Warband Members" hidden="true">
      <modifiers>
        <modifier type="set" field="moc-members-max" value="12"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="moc-hung" shared="true" includeChildSelections="true"/></conditions></modifier>
      </modifiers>
      <constraints>
        <constraint type="min" value="3" field="selections" scope="roster" shared="true" includeChildSelections="true" id="moc-members-min"/>
        <constraint type="max" value="15" field="selections" scope="roster" shared="true" includeChildSelections="true" id="moc-members-max"/>
      </constraints>
    </categoryEntry>
  </categoryEntries>
  <selectionEntries>
    <selectionEntry id="moc-config" name="Marauders of Chaos Roster" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint type="min" value="1" field="selections" scope="roster" shared="true" id="moc-config-min"/>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="moc-config-max"/>
      </constraints>
      <rules>
        <rule id="moc-roster-limits" name="Roster limits" hidden="false"><description>A warband starts with 500 gold crowns, must include at least 3 models, and may include no more than 15 models (12 for the Hung).</description></rule>
        <rule id="moc-eye" name="Eye of the Gods" hidden="false"><description>Roll 2D6 after every battle in which the leader took part. After a loss, add +1 for each Hero taken out of action; on 12+ the leader becomes a Spawn of Chaos and loses all experience, skills, injuries and equipment. If the warband already has a Spawn, erase the leader instead. After a win, add +1 for each enemy the leader took out of action; on 12+ choose a Mark of the Dark Gods for the leader. Stop testing once the leader receives a Mark; a replacement leader must prove himself anew. A warband may never include more than one Spawn.</description></rule>
        <rule id="moc-hired" name="Hired Swords" hidden="false"><description>Marauders of Chaos may hire Pit Fighters, Ogres, Norse Shamans and Imperial Assassins, plus Hired Swords that specifically permit Marauders. They may hire Witches and Warlocks unless the warband includes a warrior with the Mark of Arkhar.</description></rule>
      </rules>
      <categoryLinks>
        <categoryLink id="moc-config-cat" name="Configuration" hidden="false" targetId="4852-c4cb-82b0-b7fa" primary="true"/>
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup id="moc-tribes" name="Tribe" hidden="false" collective="false" import="true">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="moc-tribe-min"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-tribe-max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="moc-norse" name="The Norse" hidden="false" collective="false" import="true" type="upgrade">
              <constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-norse-max"/></constraints>
              <rules>
                <rule id="moc-reavers" name="Reavers" hidden="false"><description>The Norse gain +1 to rarity rolls when searching during the post-game sequence.</description></rule>
                <rule id="moc-pantheon" name="Pantheon" hidden="false"><description>For a Norse warband, the Eye of the Gods transforms the leader into a Spawn or awards a Mark only on a result of 13+ instead of 12+.</description></rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="moc-kurgan" name="The Kurgan" hidden="false" collective="false" import="true" type="upgrade">
              <constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-kurgan-max"/></constraints>
              <rules><rule id="moc-pedigree" name="Pedigree" hidden="false"><description>A Kurgan warband may include any number of Warhounds of Chaos instead of the usual maximum of five.</description></rule></rules>
            </selectionEntry>
            <selectionEntry id="moc-hung" name="The Hung" hidden="false" collective="false" import="true" type="upgrade">
              <constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="moc-hung-max"/></constraints>
              <rules>
                <rule id="moc-disloyalty" name="Disloyalty" hidden="false"><description>The maximum number of warriors in a Hung warband is 12 instead of 15.</description></rule>
                <rule id="moc-horses" name="Affinity with Horses" hidden="false"><description>Warhorses always cost 40 gold crowns. All Heroes, including promoted Henchmen, automatically have the Ride Warhorse skill. In Border Town Burning the number of mounts is unrestricted.</description></rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>

    <selectionEntry id="moc-chieftain" name="Marauder Chieftain" hidden="false" collective="false" import="true" type="model">
      <constraints>
        <constraint type="min" value="1" field="selections" scope="roster" shared="true" id="moc-chief-min"/>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="moc-chief-max"/>
      </constraints>
      <profiles><profile id="moc-chief-profile" name="Marauder Chieftain" hidden="false" typeId="e1beaa44-e54d-dd6b-d1f2-446b333c9bb9" typeName="Model"><characteristics>
        <characteristic name="M" typeId="2a0bcc4c-8266-418f-13d6-a6b44def5e92">4</characteristic><characteristic name="WS" typeId="d5aca8ba-0204-b324-b976-c2b536e09924">5</characteristic><characteristic name="BS" typeId="5b4d181b-23ae-5ed7-9262-c1d2f79246a8">3</characteristic><characteristic name="S" typeId="7f1f0a4d-68dc-b0df-5703-c4d0d91a93b9">4</characteristic><characteristic name="T" typeId="54f4796b-dedb-c296-8b1a-ff7f8043293a">4</characteristic><characteristic name="W" typeId="3172c8dc-ebe4-0c40-72ab-8fd0076b9442">1</characteristic><characteristic name="I" typeId="a6fd52b0-be0a-655e-6314-87b392c9c90e">5</characteristic><characteristic name="A" typeId="bf393c37-9d10-fc85-c147-62b1c01a89fe">1</characteristic><characteristic name="LD" typeId="e234eaea-a02a-2fb7-3e1f-605392aabb89">8</characteristic>
      </characteristics></profile></profiles>
      <rules><rule id="moc-leader" name="Leader" hidden="false"><description>Any warrior within 6&quot; of the Marauder Chieftain may use his Leadership instead of his own when taking Leadership tests.</description></rule></rules>
      <categoryLinks><categoryLink id="moc-chief-cat" name="Heroes" hidden="false" targetId="a0fce0bc-02e0-a064-7a39-5b97ff8a9c94" primary="true"/><categoryLink id="moc-chief-member" name="Warband Members" hidden="false" targetId="moc-warband-members" primary="false"/></categoryLinks>
