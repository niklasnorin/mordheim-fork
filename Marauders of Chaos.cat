      <rules>
        <rule id="78ddb5e5-2b05-4b19-92b9-834f9f2b6702" name="Wizard" hidden="false">
          <description>A Seer is a Wizard and uses the ritual list determined by his Mark of Chaos.</description>
        </rule>
        <rule id="6468bb95-3240-4487-bab9-69ec5f8979a4" name="Mark of Chaos" hidden="false">
          <description>The Seer must choose a Mark when hired. Except for Chaos Undivided, no two warriors in the warband may bear different Marks.</description>
        </rule>
      </rules>
