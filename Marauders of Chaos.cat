      <rules>
        <rule id="99936fbc-0f23-42c5-8577-d792ec25bf83" name="Undivided retinue" hidden="false">
          <description>Available only while a Seer with the Mark of Chaos Undivided remains in the warband. Re-roll all “The lad’s got talent” results for these Gors.</description>
        </rule>
      </rules>
