        <selectionEntry id="264e500e-e009-4c24-9a84-b2fa6d8a6552" name="Mark of Shornaal the Serpent" hidden="false" collective="false" type="upgrade" import="true">
          <rules>
            <rule id="19fa73ee-430a-4429-b72b-4c25667dae4a" name="Mark of Shornaal the Serpent" hidden="false">
              <description>Leader: non-Immune-to-Psychology enemies must pass a 3D6 Leadership test, discarding the lowest, to attack him in close combat; failure means they are hit automatically. Seer: uses Shornaal Rituals and, if not taken out, may make one unsellable dose of Bugman’s Ale instead of searching.</description>
            </rule>
          </rules>
          <costs>
            <cost name=" gc" typeId="points" value="0" />
            <cost name=" Warband Rating" typeId="wb-rating" value="0" />
          </costs>
          <entryLinks>
            <entryLink id="7a87372c-6cd5-464a-8ab3-a37738cd90c2" name="Shornaal Rituals" hidden="false" collective="false" targetId="b77c9912-ec22-4456-9b59-3f6d7b1b0d14" type="selectionEntryGroup" sortIndex="1" import="true" />
