    <selectionEntry id="moc-warhound" name="Warhounds of Chaos" hidden="false" collective="true" import="true" type="model">
      <modifiers><modifier type="set" field="moc-warhound-max" value="-1"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="moc-kurgan" shared="true" includeChildSelections="true"/></conditions></modifier></modifiers>
      <constraints><constraint type="max" value="5" field="selections" scope="roster" shared="true" id="moc-warhound-max"/></constraints>
      <profiles><profile id="moc-warhound-profile" name="Warhound of Chaos" hidden="false" typeId="e1beaa44-e54d-dd6b-d1f2-446b333c9bb9" typeName="Model"><characteristics>
        <characteristic name="M" typeId="2a0bcc4c-8266-418f-13d6-a6b44def5e92">7</characteristic><characteristic name="WS" typeId="d5aca8ba-0204-b324-b976-c2b536e09924">4</characteristic><characteristic name="BS" typeId="5b4d181b-23ae-5ed7-9262-c1d2f79246a8">0</characteristic><characteristic name="S" typeId="7f1f0a4d-68dc-b0df-5703-c4d0d91a93b9">4</characteristic><characteristic name="T" typeId="54f4796b-dedb-c296-8b1a-ff7f8043293a">3</characteristic><characteristic name="W" typeId="3172c8dc-ebe4-0c40-72ab-8fd0076b9442">1</characteristic><characteristic name="I" typeId="a6fd52b0-be0a-655e-6314-87b392c9c90e">3</characteristic><characteristic name="A" typeId="bf393c37-9d10-fc85-c147-62b1c01a89fe">1</characteristic><characteristic name="LD" typeId="e234eaea-a02a-2fb7-3e1f-605392aabb89">5</characteristic>
      </characteristics></profile></profiles>
      <rules><rule id="moc-animals" name="Animals" hidden="false"><description>Warhounds use no equipment, fight without penalty, and never gain experience.</description></rule></rules>
      <categoryLinks><categoryLink id="moc-warhound-cat" name="Henchmen" hidden="false" targetId="f9b08d8e-4922-78d5-78ad-2047bff52dc8" primary="true"/><categoryLink id="moc-warhound-member" name="Warband Members" hidden="false" targetId="moc-warband-members" primary="false"/></categoryLinks>
      <costs><cost name=" gc" typeId="points" value="15"/><cost name=" Warband Rating" typeId="wb-rating" value="5"/></costs>
    </selectionEntry>

    <selectionEntry id="moc-spawn" name="Spawn of Chaos" hidden="false" collective="false" import="true" type="model">
      <constraints><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="moc-spawn-max"/></constraints>
      <profiles><profile id="moc-spawn-profile" name="Spawn of Chaos" hidden="false" typeId="e1beaa44-e54d-dd6b-d1f2-446b333c9bb9" typeName="Model"><characteristics>
        <characteristic name="M" typeId="2a0bcc4c-8266-418f-13d6-a6b44def5e92">2D6</characteristic><characteristic name="WS" typeId="d5aca8ba-0204-b324-b976-c2b536e09924">3</characteristic><characteristic name="BS" typeId="5b4d181b-23ae-5ed7-9262-c1d2f79246a8">0</characteristic><characteristic name="S" typeId="7f1f0a4d-68dc-b0df-5703-c4d0d91a93b9">4</characteristic><characteristic name="T" typeId="54f4796b-dedb-c296-8b1a-ff7f8043293a">5</characteristic><characteristic name="W" typeId="3172c8dc-ebe4-0c40-72ab-8fd0076b9442">3</characteristic><characteristic name="I" typeId="a6fd52b0-be0a-655e-6314-87b392c9c90e">2</characteristic><characteristic name="A" typeId="bf393c37-9d10-fc85-c147-62b1c01a89fe">D6</characteristic><characteristic name="LD" typeId="e234eaea-a02a-2fb7-3e1f-605392aabb89">10</characteristic>
      </characteristics></profile></profiles>
      <rules>
        <rule id="moc-special-attacks" name="Special Attacks" hidden="false"><description>Roll at the beginning of each Close Combat phase to determine the Spawn&apos;s Attacks for that phase.</description></rule>
        <rule id="moc-spawn-fear" name="Fear" hidden="false"><description>The Spawn causes fear.</description></rule>
        <rule id="moc-special-movement" name="Special Movement" hidden="false"><description>In each Movement phase, turn the Spawn to face a direction, then move it 2D6&quot; straight ahead. It does not double movement when charging; if it contacts a model it counts as charging and engages it.</description></rule>
        <rule id="moc-psychology" name="Psychology" hidden="false"><description>The Spawn automatically passes every Leadership-based test it is required to make.</description></rule>
        <rule id="moc-no-brain" name="No Brain" hidden="false"><description>The Spawn uses no equipment, fights without penalty, and gains no experience.</description></rule>
        <rule id="moc-large" name="Large" hidden="false"><description>The Spawn counts as a Large Target under the shooting rules.</description></rule>
      </rules>
      <categoryLinks><categoryLink id="moc-spawn-cat" name="Henchmen" hidden="false" targetId="f9b08d8e-4922-78d5-78ad-2047bff52dc8" primary="true"/><categoryLink id="moc-spawn-member" name="Warband Members" hidden="false" targetId="moc-warband-members" primary="false"/></categoryLinks>
      <costs><cost name=" gc" typeId="points" value="180"/><cost name=" Warband Rating" typeId="wb-rating" value="20"/></costs>
    </selectionEntry>
  </selectionEntries>

  <sharedSelectionEntries>
