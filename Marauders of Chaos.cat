          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="82429eb2-659c-41ea-9765-38621ce09e4d" type="min" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="abe5cb34-13d0-4e73-922e-86ec9f480082" type="max" />
          </constraints>
          <costs>
            <cost name=" gc" typeId="points" value="180" />
            <cost name=" Warband Rating" typeId="wb-rating" value="5" />
          </costs>
        </selectionEntry>
      </selectionEntries>
      <rules>
        <rule id="4f087865-7115-4227-906a-f8e87413ac3d" name="Special Attacks" hidden="false">
          <description>Roll at the beginning of each Close Combat phase to determine the Spawn’s Attacks for that phase.</description>
        </rule>
        <rule id="067b76db-33a1-40f3-8ec8-17c4d78125c6" name="Fear" hidden="false">
          <description>The Spawn causes fear.</description>
        </rule>
        <rule id="74efc44d-6c04-47e6-8094-7c4b51ce574f" name="Special Movement" hidden="false">
          <description>The Spawn moves 2D6” straight ahead in each Movement phase after first turning to face any direction. It does not double movement when charging; contact counts as a charge.</description>
        </rule>
        <rule id="7ead1016-2667-45fe-8104-6be42027de5b" name="Psychology" hidden="false">
          <description>The Spawn automatically passes all Leadership-based tests.</description>
        </rule>
        <rule id="4bb0733e-cbf5-40b8-a66b-95203e66d8fe" name="No Brain" hidden="false">
          <description>The Spawn gains no experience.</description>
        </rule>
        <rule id="ab16f17d-85a3-4629-92b3-d36b2727d2f4" name="Large" hidden="false">
          <description>The Spawn counts as a Large Target.</description>
        </rule>
      </rules>
    </selectionEntry>
