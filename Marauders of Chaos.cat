    <selectionEntryGroup id="8de3a7d2-e0cc-4cb4-9103-41d2cbe42195" name="Mark of Chaos" hidden="false" collective="false" collapsible="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="e781f986-fe63-4a83-8a5b-93e436a00534" type="max" />
      </constraints>
      <selectionEntries>
        <selectionEntry id="c29a958d-8772-4796-8a8d-f822fe16630c" name="Mark of Chaos Undivided" hidden="false" collective="false" type="upgrade" import="true">
          <rules>
            <rule id="da67db6b-81fd-4521-b4c8-057eef35ed70" name="Mark of Chaos Undivided" hidden="false">
              <description>Leader: all warriors in the Leader radius may re-roll failed Leadership tests. Seer: enables 0–3 Gors; re-roll their “The lad’s got talent” results. The Seer uses Chaos Rituals.</description>
            </rule>
          </rules>
          <costs>
            <cost name=" gc" typeId="points" value="0" />
            <cost name=" Warband Rating" typeId="wb-rating" value="0" />
          </costs>
          <entryLinks>
            <entryLink id="10c38f20-5afd-414f-a4a2-338ca8f9eb19" name="Chaos Rituals" hidden="false" collective="false" targetId="61c7-8179-00b5-1772" type="selectionEntryGroup" sortIndex="1" import="true" />
          </entryLinks>
        </selectionEntry>
        <selectionEntry id="1369e859-5870-4423-9be2-87d8775af9fe" name="Mark of Tchar the Eagle" hidden="false" collective="false" type="upgrade" import="true">
          <rules>
            <rule id="22dfa8b7-9050-451a-87f5-615e409898af" name="Mark of Tchar the Eagle" hidden="false">
              <description>Leader: becomes a wizard and learns one random Tchar Ritual, but suffers -1 to casting Difficulty unless already a wizard. Seer: starts with two Tchar Rituals, one chosen and one random.</description>
            </rule>
          </rules>
          <costs>
            <cost name=" gc" typeId="points" value="0" />
            <cost name=" Warband Rating" typeId="wb-rating" value="0" />
          </costs>
          <entryLinks>
            <entryLink id="b8af0545-9390-401d-972a-87df56df51e1" name="Tchar Rituals" hidden="false" collective="false" targetId="98685110-5384-4cd1-b623-8d3e286579f0" type="selectionEntryGroup" sortIndex="1" import="true" />
          </entryLinks>
          <modifiers>
            <modifier type="add" field="error" value="The warband may not include different Marks of Chaos (Chaos Undivided is the exception).">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="54d2eaae-bef0-4269-a4d9-2655cbb91157" shared="true" />
              </conditions>
            </modifier>
            <modifier type="add" field="error" value="The warband may not include different Marks of Chaos (Chaos Undivided is the exception).">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="ed91ea4c-8661-4240-b79c-cd2d482ee758" shared="true" />
