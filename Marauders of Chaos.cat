    <selectionEntry id="moc-condemned" name="Condemned" hidden="false" collective="false" import="true" type="model">
      <constraints><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="moc-condemned-max"/></constraints>
      <profiles><profile id="moc-condemned-profile" name="Condemned" hidden="false" typeId="e1beaa44-e54d-dd6b-d1f2-446b333c9bb9" typeName="Model"><characteristics>
        <characteristic name="M" typeId="2a0bcc4c-8266-418f-13d6-a6b44def5e92">4</characteristic><characteristic name="WS" typeId="d5aca8ba-0204-b324-b976-c2b536e09924">D6</characteristic><characteristic name="BS" typeId="5b4d181b-23ae-5ed7-9262-c1d2f79246a8">3</characteristic><characteristic name="S" typeId="7f1f0a4d-68dc-b0df-5703-c4d0d91a93b9">D6</characteristic><characteristic name="T" typeId="54f4796b-dedb-c296-8b1a-ff7f8043293a">D6</characteristic><characteristic name="W" typeId="3172c8dc-ebe4-0c40-72ab-8fd0076b9442">1</characteristic><characteristic name="I" typeId="a6fd52b0-be0a-655e-6314-87b392c9c90e">4</characteristic><characteristic name="A" typeId="bf393c37-9d10-fc85-c147-62b1c01a89fe">D3</characteristic><characteristic name="LD" typeId="e234eaea-a02a-2fb7-3e1f-605392aabb89">7</characteristic>
      </characteristics></profile></profiles>
      <rules>
        <rule id="moc-inconsistency" name="Inconsistency" hidden="false"><description>Determine the variable WS, S, T and A whenever needed, once every turn.</description></rule>
        <rule id="moc-condemned-fear" name="Fear" hidden="false"><description>The Condemned causes fear.</description></rule>
        <rule id="moc-condemned-experience" name="Experience" hidden="false"><description>When a variable characteristic would increase, roll its die instead. The player may permanently set the characteristic to that result or leave it variable and lose the advance. The Marauder maximum may be exceeded.</description></rule>
        <rule id="moc-fate" name="Fate" hidden="false"><description>The Condemned uses no equipment and fights without penalty. Once all variable characteristics are fixed, he may use equipment normally. If he reaches 90 Experience with any variable characteristic, he becomes a Spawn of Chaos; if the warband already has one, remove him from the roster.</description></rule>
      </rules>
      <categoryLinks><categoryLink id="moc-condemned-cat" name="Heroes" hidden="false" targetId="a0fce0bc-02e0-a064-7a39-5b97ff8a9c94" primary="true"/><categoryLink id="moc-condemned-member" name="Warband Members" hidden="false" targetId="moc-warband-members" primary="false"/></categoryLinks>
      <entryLinks>
        <entryLink id="moc-condemned-exp" name="Experience" hidden="false" collective="false" import="true" targetId="d769-0d85-e810-df60" type="selectionEntry"><constraints><constraint type="min" value="8" field="selections" scope="parent" shared="true" id="moc-condemned-exp-min"/></constraints></entryLink>
        <entryLink id="moc-condemned-combat" name="Combat Skills" hidden="false" collective="false" import="true" targetId="ee2c-89e3-489b-d0cb" type="selectionEntryGroup"/>
        <entryLink id="moc-condemned-strength" name="Strength Skills" hidden="false" collective="false" import="true" targetId="e5ac-cd5b-9057-e096" type="selectionEntryGroup"/>
        <entryLink id="moc-condemned-speed" name="Speed Skills" hidden="false" collective="false" import="true" targetId="e134-0fdf-67a2-4684" type="selectionEntryGroup"/>
        <entryLink id="moc-condemned-special" name="Marauder Special Skills" hidden="false" collective="false" import="true" targetId="moc-special-skills" type="selectionEntryGroup"/>
      </entryLinks>
      <costs><cost name=" gc" typeId="points" value="55"/><cost name=" Warband Rating" typeId="wb-rating" value="5"/></costs>
    </selectionEntry>

